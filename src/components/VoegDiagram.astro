---
interface Props {
  type: 'snijvoeg' | 'platvol' | 'schaduwvoeg';
}
const { type } = Astro.props;

const BRICK = '#B5502E';
const BRICK_LINE = '#8A3A20';
const MORTAR = '#B9B3A6';
const MORTAR_LINE = '#8F897C';

// Right edge of the brick face (the reference plane visitors actually see).
const faceX = 150;
// How far the mortar sits back from that plane for the schaduwvoeg.
const recess = type === 'schaduwvoeg' ? 16 : 0;
const mortarX = faceX - recess;

const bricks = [
  { y: 20 },
  { y: 108 },
  { y: 196 },
];
const brickH = 76;
const jointH = 12;
---

<svg viewBox="0 0 210 300" class="h-full w-full">
  {bricks.map((b) => (
    <rect x="40" y={b.y} width={faceX - 40} height={brickH} fill={BRICK} stroke={BRICK_LINE} stroke-width="1.5" />
  ))}

  {/* mortar joints between the 3 brick courses */}
  {[bricks[0].y + brickH, bricks[1].y + brickH].map((jointY) => (
    <>
      <rect x="40" y={jointY} width={mortarX - 40} height={jointH} fill={MORTAR} stroke={MORTAR_LINE} stroke-width="1" />
      {type === 'snijvoeg' && (
        <>
          <line x1={mortarX} y1={jointY} x2={mortarX - 7} y2={jointY + jointH / 2} stroke={MORTAR_LINE} stroke-width="1.5" />
          <line x1={mortarX - 7} y1={jointY + jointH / 2} x2={mortarX} y2={jointY + jointH} stroke={MORTAR_LINE} stroke-width="1.5" />
        </>
      )}
      {type === 'schaduwvoeg' && (
        <rect x={mortarX} y={jointY} width={recess} height={jointH} fill="#3A3530" opacity="0.35" />
      )}
    </>
  ))}

  {/* facade face plane + label */}
  <line x1={faceX} y1="10" x2={faceX} y2="290" stroke="#24272B" stroke-width="1" stroke-dasharray="3 3" opacity="0.35" />
  <line x1={faceX + 14} y1="150" x2={faceX + 40} y2="150" stroke="#24272B" stroke-width="1.5" marker-end="url(#arrow)" />
  <text x={faceX + 44} y="154" font-size="11" fill="#24272B" font-family="Work Sans, sans-serif">gevelzijde</text>

  <defs>
    <marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
      <path d="M0,0 L6,3 L0,6 Z" fill="#24272B" />
    </marker>
  </defs>
</svg>
