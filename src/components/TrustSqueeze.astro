---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Panel {
  number: string;
  label: string;
  title: string;
  description: string;
  actionLabel: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;
---

<div id="trust-squeeze">
  <div class="squeeze-row">
    {panels.map((panel, i) => (
      <div class={`squeeze-panel ${i === 0 ? 'is-active' : ''}`} data-index={i}>
        <button type="button" class="squeeze-header" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span class="squeeze-number" aria-hidden="true">{panel.number}</span>
          <span class="squeeze-heading">{panel.actionLabel}</span>
          <svg class="squeeze-chevron md:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </button>
        <div class="squeeze-body">
          <div class="squeeze-media">
            <Image
              src={panel.image}
              alt={panel.imageAlt}
              class="squeeze-img"
              widths={[400, 800, 1200]}
              sizes="(min-width: 768px) 40vw, 100vw"
            />
            <div class="squeeze-scrim" aria-hidden="true"></div>
          </div>
          <div class="squeeze-content">
            <h3 class="font-display text-lg font-semibold uppercase tracking-wide text-sand sm:text-xl">
              {panel.title}
            </h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-sand-2/90">{panel.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* Mobile: full-width accordion rows */
  .squeeze-row {
    display: block;
  }

  .squeeze-panel {
    border-bottom: 1px solid rgba(241, 234, 224, 0.15);
  }

  .squeeze-panel:first-child {
    border-top: 1px solid rgba(241, 234, 224, 0.15);
  }

  .squeeze-header {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .squeeze-number {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .squeeze-heading {
    flex: 1 1 auto;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-sand);
  }

  .squeeze-chevron {
    flex: 0 0 auto;
    color: var(--color-accent);
    transition: transform 300ms ease;
  }

  .squeeze-panel.is-active .squeeze-chevron {
    transform: rotate(180deg);
  }

  .squeeze-body {
    display: none;
    padding-bottom: 1.25rem;
  }

  .squeeze-panel.is-active .squeeze-body {
    display: block;
  }

  .squeeze-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-brand);
  }

  .squeeze-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .squeeze-scrim {
    display: none;
  }

  .squeeze-content {
    padding: 0.9rem 0.25rem 0;
  }

  @media (min-width: 768px) {
    .squeeze-row {
      display: flex;
      flex-direction: row;
      gap: 1rem;
      height: 26rem;
    }

    .squeeze-panel {
      position: relative;
      flex: 1 1 0%;
      min-width: 0;
      height: 100%;
      border: none;
      border-radius: var(--radius-brand);
      overflow: hidden;
      transition: flex-grow 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .squeeze-panel:first-child {
      border-top: none;
    }

    .squeeze-panel.is-active {
      flex-grow: 4.5;
    }

    .squeeze-header {
      position: absolute;
      z-index: 2;
      top: 1rem;
      left: 1.1rem;
      right: 1.1rem;
      width: auto;
      padding: 0;
      align-items: flex-start;
      justify-content: space-between;
    }

    .squeeze-number {
      font-size: 1.5rem;
      opacity: 0.9;
    }

    .squeeze-heading {
      flex: 0 1 auto;
      font-size: 1.25rem;
      text-align: right;
      white-space: nowrap;
      transform-origin: bottom right;
      transform: rotate(-90deg);
      transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .squeeze-panel.is-active .squeeze-heading {
      transform: rotate(0deg);
    }

    .squeeze-body {
      display: block;
      height: 100%;
      padding-bottom: 0;
    }

    .squeeze-media {
      height: 100%;
      aspect-ratio: auto;
      border-radius: 0;
    }

    .squeeze-trigger:hover .squeeze-img,
    .squeeze-panel:hover .squeeze-img {
      transform: scale(1.04);
    }

    .squeeze-scrim {
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(24, 26, 29, 0.88) 0%, rgba(24, 26, 29, 0.35) 45%, rgba(24, 26, 29, 0.15) 100%);
    }

    .squeeze-content {
      position: absolute;
      left: 1.25rem;
      right: 1.5rem;
      bottom: 1.25rem;
      padding: 0;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 350ms ease, transform 350ms ease;
      pointer-events: none;
    }

    .squeeze-panel.is-active .squeeze-content {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
</style>

<script>
  const root = document.getElementById('trust-squeeze');
  if (root) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.squeeze-panel'));

    function activate(index: number) {
      for (const p of panels) {
        const isActive = p.dataset.index === String(index);
        p.classList.toggle('is-active', isActive);
        p.querySelector('.squeeze-header')?.setAttribute('aria-expanded', String(isActive));
      }
    }

    panels.forEach((panel, i) => {
      const header = panel.querySelector('.squeeze-header');
      header?.addEventListener('click', () => {
        // On mobile, tapping the already-open row collapses it; every other
        // breakpoint always keeps exactly one panel open (squeeze behaviour).
        if (window.matchMedia('(max-width: 767px)').matches && panel.classList.contains('is-active')) {
          panel.classList.remove('is-active');
          header.setAttribute('aria-expanded', 'false');
        } else {
          activate(i);
        }
      });
      header?.addEventListener('focus', () => {
        if (window.matchMedia('(min-width: 768px)').matches) activate(i);
      });
      if (window.matchMedia('(hover: hover) and (min-width: 768px)').matches) {
        panel.addEventListener('mouseenter', () => activate(i));
      }
    });
  }
</script>
