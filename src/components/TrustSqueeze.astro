---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Panel {
  number: string;
  label: string;
  title: string;
  description: string;
  actionLabel: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;
---

<div id="trust-squeeze">
  <!-- Desktop: interactive squeeze strip -->
  <div class="squeeze-row hidden md:flex">
    {panels.map((panel, i) => (
      <div class={`squeeze-panel ${i === 0 ? 'is-active' : ''}`} data-index={i}>
        <button type="button" class="squeeze-header" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span class="squeeze-number" aria-hidden="true">{panel.number}</span>
          <span class="squeeze-heading">{panel.actionLabel}</span>
        </button>
        <div class="squeeze-body">
          <div class="squeeze-media">
            <Image
              src={panel.image}
              alt={panel.imageAlt}
              class="squeeze-img"
              widths={[400, 800, 1200]}
              sizes="40vw"
            />
            <div class="squeeze-scrim" aria-hidden="true"></div>
          </div>
          <div class="squeeze-content">
            <h3 class="font-display text-lg font-semibold uppercase tracking-wide text-sand sm:text-xl">
              {panel.title}
            </h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-sand-2/90">{panel.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Mobile: 2-col grid; tapping a tile expands it to full width in place -->
  <div class="squeeze-grid md:hidden">
    {panels.map((panel, i) => (
      <div class="squeeze-tile" data-index={i}>
        <button type="button" class="squeeze-tile-header" aria-expanded="false">
          <span class="squeeze-tile-num">{panel.number}</span>
          <span class="squeeze-tile-label">{panel.actionLabel}</span>
          <svg class="squeeze-tile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </button>
        <div class="squeeze-tile-body">
          <Image
            src={panel.image}
            alt={panel.imageAlt}
            class="squeeze-tile-img"
            widths={[400, 800]}
            sizes="100vw"
          />
          <div class="squeeze-tile-text">
            <h3 class="font-display text-base font-semibold uppercase tracking-wide text-sand">{panel.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sand-2/90">{panel.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* ---------- Mobile: 2-col grid, tap to expand in place ---------- */
  @media (max-width: 767.98px) {
    .squeeze-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      align-items: start;
    }

    .squeeze-tile {
      border-radius: var(--radius-brand);
      border: 1px solid rgba(241, 234, 224, 0.18);
      background: rgba(241, 234, 224, 0.05);
      overflow: hidden;
    }

    .squeeze-tile.is-active {
      grid-column: 1 / -1;
    }

    .squeeze-tile-header {
      display: flex;
      width: 100%;
      aspect-ratio: 1 / 1;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.5rem;
      border: none;
      background: none;
      cursor: pointer;
      text-align: center;
    }

    .squeeze-tile.is-active .squeeze-tile-header {
      aspect-ratio: auto;
      flex-direction: row;
      justify-content: space-between;
      padding: 0.9rem 1rem;
      text-align: left;
    }

    .squeeze-tile-num {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-accent);
    }

    .squeeze-tile.is-active .squeeze-tile-num {
      font-size: 1.1rem;
    }

    .squeeze-tile-label {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--color-sand);
      line-height: 1.25;
    }

    .squeeze-tile.is-active .squeeze-tile-label {
      flex: 1 1 auto;
      margin: 0 0.75rem;
      font-size: 0.95rem;
    }

    .squeeze-tile-chevron {
      display: none;
      flex: 0 0 auto;
      color: var(--color-accent);
      transition: transform 300ms ease;
    }

    .squeeze-tile.is-active .squeeze-tile-chevron {
      display: block;
      transform: rotate(180deg);
    }

    .squeeze-tile-body {
      display: none;
    }

    .squeeze-tile.is-active .squeeze-tile-body {
      display: block;
    }

    .squeeze-tile-img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .squeeze-tile-text {
      padding: 1rem 1.1rem 1.25rem;
    }
  }

  /* ---------- Desktop: squeeze strip ---------- */
  @media (min-width: 768px) {
    .squeeze-row {
      gap: 1rem;
      height: 26rem;
    }

    .squeeze-panel {
      position: relative;
      flex: 1 1 0%;
      min-width: 0;
      height: 100%;
      border-radius: var(--radius-brand);
      overflow: hidden;
      transition: flex-grow 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .squeeze-panel.is-active {
      flex-grow: 4.5;
    }

    .squeeze-header {
      display: block;
      position: static;
      width: 0;
      height: 0;
      padding: 0;
      margin: 0;
      border: none;
      background: none;
      overflow: visible;
    }

    .squeeze-number {
      position: absolute;
      z-index: 2;
      top: 1rem;
      left: 1.1rem;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-accent);
      opacity: 0.9;
    }

    .squeeze-heading {
      position: absolute;
      z-index: 2;
      top: 1rem;
      right: 1.1rem;
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--color-sand);
      white-space: nowrap;
      text-align: right;
      transform-origin: bottom right;
      transform: rotate(-90deg);
      transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .squeeze-panel.is-active .squeeze-heading {
      transform: rotate(0deg);
    }

    .squeeze-body {
      height: 100%;
    }

    .squeeze-media {
      position: relative;
      height: 100%;
      overflow: hidden;
    }

    .squeeze-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 700ms ease;
    }

    .squeeze-panel:hover .squeeze-img {
      transform: scale(1.04);
    }

    .squeeze-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(24, 26, 29, 0.88) 0%, rgba(24, 26, 29, 0.35) 45%, rgba(24, 26, 29, 0.15) 100%);
    }

    .squeeze-content {
      position: absolute;
      left: 1.25rem;
      right: 1.5rem;
      bottom: 1.25rem;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 350ms ease, transform 350ms ease;
      pointer-events: none;
    }

    .squeeze-panel.is-active .squeeze-content {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
</style>

<script>
  const root = document.getElementById('trust-squeeze');
  if (root) {
    // Desktop squeeze strip
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.squeeze-panel'));

    function activate(index: number) {
      for (const p of panels) {
        const isActive = p.dataset.index === String(index);
        p.classList.toggle('is-active', isActive);
        p.querySelector('.squeeze-header')?.setAttribute('aria-expanded', String(isActive));
      }
    }

    panels.forEach((panel, i) => {
      const header = panel.querySelector('.squeeze-header');
      header?.addEventListener('click', () => activate(i));
      header?.addEventListener('focus', () => activate(i));
      if (window.matchMedia('(hover: hover)').matches) {
        panel.addEventListener('mouseenter', () => activate(i));
      }
    });

    // Mobile grid: tap a tile to expand it full-width in place
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('.squeeze-tile'));

    tiles.forEach((tile) => {
      const header = tile.querySelector('.squeeze-tile-header');
      header?.addEventListener('click', () => {
        const willOpen = !tile.classList.contains('is-active');
        for (const t of tiles) {
          t.classList.remove('is-active');
          t.querySelector('.squeeze-tile-header')?.setAttribute('aria-expanded', 'false');
        }
        if (willOpen) {
          tile.classList.add('is-active');
          header.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
</script>
