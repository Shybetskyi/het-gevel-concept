---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Panel {
  number: string;
  label: string;
  title: string;
  description: string;
  actionLabel: string;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;
---

<div id="trust-squeeze">
  <!-- Desktop: interactive squeeze strip -->
  <div class="squeeze-row hidden md:flex">
    {panels.map((panel, i) => (
      <div class={`squeeze-panel ${i === 0 ? 'is-active' : ''}`} data-index={i}>
        <button type="button" class="squeeze-header" aria-expanded={i === 0 ? 'true' : 'false'}>
          <span class="squeeze-number" aria-hidden="true">{panel.number}</span>
          <span class="squeeze-heading">{panel.actionLabel}</span>
        </button>
        <div class="squeeze-body">
          <div class="squeeze-media">
            <Image
              src={panel.image}
              alt={panel.imageAlt}
              class="squeeze-img"
              widths={[400, 800, 1200]}
              sizes="40vw"
            />
            <div class="squeeze-scrim" aria-hidden="true"></div>
          </div>
          <div class="squeeze-content">
            <h3 class="font-display text-lg font-semibold uppercase tracking-wide text-sand sm:text-xl">
              {panel.title}
            </h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-sand-2/90">{panel.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Mobile: 2x2 grid, tap to open a modal -->
  <div class="squeeze-grid md:hidden">
    {panels.map((panel, i) => (
      <button type="button" class="squeeze-tile" data-open={i}>
        <span class="squeeze-tile-num">{panel.number}</span>
        <span class="squeeze-tile-label">{panel.actionLabel}</span>
      </button>
    ))}
  </div>

  {panels.map((panel, i) => (
    <dialog class="squeeze-dialog" data-dialog={i}>
      <button type="button" class="squeeze-dialog-close" aria-label="Sluiten">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <Image
        src={panel.image}
        alt={panel.imageAlt}
        class="squeeze-dialog-img"
        widths={[400, 800]}
        sizes="90vw"
      />
      <div class="squeeze-dialog-body">
        <span class="squeeze-dialog-num">{panel.number}</span>
        <h3 class="mt-2 font-display text-lg font-semibold uppercase tracking-wide text-sand">{panel.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-sand-2/90">{panel.description}</p>
      </div>
    </dialog>
  ))}
</div>

<style>
  /* ---------- Mobile: 2x2 grid + modal ---------- */
  /* Scoped to a max-width query (not just relying on Tailwind's md:hidden)
     so these rules can never win a specificity tie against md:flex/hidden
     on the desktop markup, regardless of CSS source order. */
  @media (max-width: 767.98px) {
    .squeeze-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .squeeze-tile {
      aspect-ratio: 1 / 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border-radius: var(--radius-brand);
      border: 1px solid rgba(241, 234, 224, 0.18);
      background: rgba(241, 234, 224, 0.05);
      cursor: pointer;
      padding: 0.5rem;
      text-align: center;
    }

    .squeeze-tile-num {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-accent);
    }

    .squeeze-tile-label {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--color-sand);
      line-height: 1.25;
    }
  }

  .squeeze-dialog {
    width: min(90vw, 440px);
    max-height: 85vh;
    margin: auto;
    padding: 0;
    border: none;
    border-radius: var(--radius-brand);
    background: var(--color-primary);
    color: var(--color-sand);
    overflow: hidden auto;
  }

  .squeeze-dialog::backdrop {
    background: rgba(15, 16, 18, 0.72);
  }

  .squeeze-dialog-close {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: none;
    background: rgba(15, 16, 18, 0.55);
    color: var(--color-sand);
    cursor: pointer;
  }

  .squeeze-dialog-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .squeeze-dialog-body {
    padding: 1.1rem 1.25rem 1.4rem;
  }

  .squeeze-dialog-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  /* ---------- Desktop: squeeze strip ---------- */
  /* Scoped to a min-width query to match md:flex exactly, for the same
     specificity-safety reason as the mobile block above. */
  @media (min-width: 768px) {
    .squeeze-row {
      gap: 1rem;
      height: 26rem;
    }

    .squeeze-panel {
      position: relative;
      flex: 1 1 0%;
      min-width: 0;
      height: 100%;
      border-radius: var(--radius-brand);
      overflow: hidden;
      transition: flex-grow 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .squeeze-panel.is-active {
      flex-grow: 4.5;
    }

    .squeeze-header {
      display: block;
      position: static;
      width: 0;
      height: 0;
      padding: 0;
      margin: 0;
      border: none;
      background: none;
      overflow: visible;
    }

    .squeeze-number {
      position: absolute;
      z-index: 2;
      top: 1rem;
      left: 1.1rem;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-accent);
      opacity: 0.9;
    }

    .squeeze-heading {
      position: absolute;
      z-index: 2;
      top: 1rem;
      right: 1.1rem;
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--color-sand);
      white-space: nowrap;
      text-align: right;
      transform-origin: bottom right;
      transform: rotate(-90deg);
      transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .squeeze-panel.is-active .squeeze-heading {
      transform: rotate(0deg);
    }

    .squeeze-body {
      height: 100%;
    }

    .squeeze-media {
      position: relative;
      height: 100%;
      overflow: hidden;
    }

    .squeeze-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 700ms ease;
    }

    .squeeze-panel:hover .squeeze-img {
      transform: scale(1.04);
    }

    .squeeze-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(24, 26, 29, 0.88) 0%, rgba(24, 26, 29, 0.35) 45%, rgba(24, 26, 29, 0.15) 100%);
    }

    .squeeze-content {
      position: absolute;
      left: 1.25rem;
      right: 1.5rem;
      bottom: 1.25rem;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 350ms ease, transform 350ms ease;
      pointer-events: none;
    }

    .squeeze-panel.is-active .squeeze-content {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
</style>

<script>
  const root = document.getElementById('trust-squeeze');
  if (root) {
    // Desktop squeeze strip
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.squeeze-panel'));

    function activate(index: number) {
      for (const p of panels) {
        const isActive = p.dataset.index === String(index);
        p.classList.toggle('is-active', isActive);
        p.querySelector('.squeeze-header')?.setAttribute('aria-expanded', String(isActive));
      }
    }

    panels.forEach((panel, i) => {
      const header = panel.querySelector('.squeeze-header');
      header?.addEventListener('click', () => activate(i));
      header?.addEventListener('focus', () => activate(i));
      if (window.matchMedia('(hover: hover)').matches) {
        panel.addEventListener('mouseenter', () => activate(i));
      }
    });

    // Mobile grid + modal
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.squeeze-tile'));
    const dialogs = Array.from(root.querySelectorAll<HTMLDialogElement>('.squeeze-dialog'));

    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        const dialog = dialogs.find((d) => d.dataset.dialog === tile.dataset.open);
        dialog?.showModal();
      });
    });

    dialogs.forEach((dialog) => {
      dialog.querySelector('.squeeze-dialog-close')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    });
  }
</script>
