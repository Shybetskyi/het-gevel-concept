---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center bg-sand-2 text-center font-body text-xs font-semibold uppercase tracking-wide text-mortar',
    className,
  ]}
  data-placeholder="true"
>
  {label}
</div>
