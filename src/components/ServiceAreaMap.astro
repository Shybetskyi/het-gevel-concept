---
// Free, no-API-key map (Leaflet + OpenStreetMap tiles) showing the real
// Dutch provinces that make up the service area, with a single HQ marker
// on Ermelo. Province boundaries: CBS / cartomap.github.io (provincie_2023).
import provincies from '../data/nl-provincies.json';

const mapId = `service-map-${Math.random().toString(36).slice(2, 9)}`;
const HQ: [number, number] = [52.2966, 5.6294]; // Ermelo
const HIGHLIGHT = ['Gelderland', 'Flevoland', 'Utrecht', 'Overijssel'];
---

<div class="aspect-video w-full overflow-hidden rounded-brand border border-sand-2">
  <div id={mapId} class="h-full w-full" role="img" aria-label="Kaart van het werkgebied van Het Gevel Concept: Gelderland, Flevoland, Utrecht en Overijssel"></div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>

<script define:vars={{ mapId, provincies, HQ, HIGHLIGHT }}>
  function initMap() {
    // @ts-ignore - Leaflet loaded globally via CDN script
    const L = window.L;
    const el = document.getElementById(mapId);
    if (!L || !el || el.dataset.ready) return;
    el.dataset.ready = 'true';

    const styles = getComputedStyle(document.documentElement);
    const accent = styles.getPropertyValue('--color-accent').trim() || '#c1502e';
    const primary = styles.getPropertyValue('--color-primary').trim() || '#24272b';

    const map = L.map(el, { scrollWheelZoom: false, attributionControl: true });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      className: 'hgc-tiles',
    }).addTo(map);

    const isHighlighted = (feature) => HIGHLIGHT.includes(feature.properties.statnaam);

    const provinceLayer = L.geoJSON(provincies, {
      style: (feature) =>
        isHighlighted(feature)
          ? { color: accent, weight: 2, opacity: 0.9, fillColor: accent, fillOpacity: 0.18 }
          : { color: primary, weight: 1, opacity: 0.25, fillColor: primary, fillOpacity: 0.04 },
    }).addTo(map);

    const hqIcon = L.divIcon({
      className: '',
      html: `<span style="display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:${accent};border:3px solid ${primary};box-shadow:0 1px 4px rgba(0,0,0,.35);"></span>`,
      iconSize: [26, 26],
      iconAnchor: [13, 13],
    });
    L.marker(HQ, { icon: hqIcon }).addTo(map).bindPopup('<strong>Ermelo</strong><br>Hoofdkantoor');

    const highlightedBounds = L.geoJSON({
      type: 'FeatureCollection',
      features: provincies.features.filter(isHighlighted),
    }).getBounds();

    map.fitBounds(highlightedBounds, { padding: [16, 16] });
  }

  if (document.readyState !== 'loading') {
    window.L ? initMap() : window.addEventListener('load', initMap);
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      window.L ? initMap() : window.addEventListener('load', initMap);
    });
  }
</script>

<style>
  :global(.hgc-tiles) {
    filter: saturate(0.85) contrast(0.97);
  }
  :global(.leaflet-popup-content-wrapper) {
    font-family: "Work Sans", ui-sans-serif, system-ui, sans-serif;
    border-radius: 10px;
  }
</style>
