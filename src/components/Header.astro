---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon.svg';
import { NAV_LINKS, SERVICES } from '../consts';

const currentPath = Astro.url.pathname;
const dienstenHref = '/#diensten';
const dienstenActive = currentPath.startsWith('/diensten');
---

<header class="sticky top-0 z-40 border-b border-sand-2 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="flex flex-col items-start">
      <Image src={logoIcon} alt="Het Gevel Concept" class="h-14 w-auto" />
      <span class="mt-1 font-display text-lg font-semibold uppercase tracking-wide text-primary">
        Het <span class="text-accent">Gevel</span> Concept
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {NAV_LINKS.map((link) => (
        link.href === '/diensten/' ? (
          <div class="group relative">
            <a
              href={dienstenHref}
              class:list={[
                'flex items-center gap-1 font-body text-sm font-semibold uppercase tracking-wide text-primary/80 hover:text-accent',
                dienstenActive && 'text-accent',
              ]}
            >
              {link.label}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </a>
            <div class="invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 pt-3 opacity-0 transition duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="rounded-brand border border-sand-2 bg-paper p-2 shadow-lg">
                {SERVICES.map((service) => (
                  <a
                    href={`/diensten/${service.slug}/`}
                    class="block rounded-brand px-4 py-2.5 font-body text-sm font-semibold text-primary hover:bg-sand hover:text-accent"
                  >
                    {service.title}
                  </a>
                ))}
                <a
                  href="/diensten/"
                  class="mt-1 block rounded-brand px-4 py-2.5 font-body text-sm font-semibold uppercase tracking-wide text-accent hover:bg-sand"
                >
                  Alle diensten &rarr;
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class:list={[
              'font-body text-sm font-semibold uppercase tracking-wide text-primary/80 hover:text-accent',
              (link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href)) && 'text-accent',
            ]}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <a
      href="/contact/offerte-aanvragen/"
      class="hidden rounded-brand bg-accent px-5 py-2.5 font-display text-sm font-semibold uppercase tracking-wide text-paper hover:opacity-90 md:inline-block"
    >
      Offerte aanvragen
    </a>

    <button
      id="mobile-menu-toggle"
      class="inline-flex items-center justify-center rounded-brand border border-primary/20 p-2 md:hidden"
      aria-label="Menu openen"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-sand-2 bg-paper px-5 py-4 md:hidden">
    {NAV_LINKS.map((link) => (
      <>
        <a
          href={link.href === '/diensten/' ? dienstenHref : link.href}
          class="rounded-brand px-2 py-2.5 font-body text-sm font-semibold uppercase text-primary hover:bg-sand"
        >
          {link.label}
        </a>
        {link.href === '/diensten/' && (
          <div class="ml-3 flex flex-col gap-0.5 border-l border-sand-2 pl-3">
            {SERVICES.map((service) => (
              <a
                href={`/diensten/${service.slug}/`}
                class="rounded-brand px-2 py-2 font-body text-sm text-primary/80 hover:bg-sand hover:text-accent"
              >
                {service.title}
              </a>
            ))}
          </div>
        )}
      </>
    ))}
    <a
      href="/contact/offerte-aanvragen/"
      class="mt-2 rounded-brand bg-accent px-4 py-2.5 text-center font-display text-sm font-semibold uppercase text-paper"
    >
      Offerte aanvragen
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
