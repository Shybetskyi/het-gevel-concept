---
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t-2 border-primary bg-paper p-5 shadow-lg sm:flex sm:items-center sm:justify-between sm:gap-6"
>
  <p class="mb-3 text-sm text-primary/90 sm:mb-0">
    Wij gebruiken alleen cookies die nodig zijn om de site te laten werken, en
    (na uw toestemming) anonieme statistieken. Lees ons
    <a href="/cookiebeleid/" class="underline hover:text-accent">cookiebeleid</a>.
  </p>
  <div class="flex shrink-0 gap-3">
    <button
      id="cookie-reject"
      class="rounded-brand border border-primary px-4 py-2 text-sm font-semibold text-primary hover:bg-primary hover:text-paper"
    >
      Weigeren
    </button>
    <button
      id="cookie-accept"
      class="rounded-brand bg-accent px-4 py-2 text-sm font-semibold text-paper hover:opacity-90"
    >
      Accepteren
    </button>
  </div>
</div>

<script define:vars={{ GA4_ID }}>
  const STORAGE_KEY = 'hgc-cookie-consent';
  const banner = document.getElementById('cookie-banner');

  function loadGA4() {
    if (!GA4_ID) return;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA4_ID, { anonymize_ip: true });
  }

  const stored = localStorage.getItem(STORAGE_KEY);
  if (stored === 'accepted') {
    loadGA4();
  } else if (stored !== 'rejected') {
    banner?.classList.remove('hidden');
    banner?.classList.add('flex');
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    banner?.classList.add('hidden');
    loadGA4();
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'rejected');
    banner?.classList.add('hidden');
  });
</script>
