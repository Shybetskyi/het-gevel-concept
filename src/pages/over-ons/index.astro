---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import GoogleMap from '../../components/GoogleMap.astro';
import gevelImage from '../../assets/generated/overons-gevel.jpg';

const kenmerken = [
  {
    nr: '01',
    title: 'Gecertificeerd vakmanschap',
    text: 'Al ons werk wordt uitgevoerd door gecertificeerde vakspecialisten — geen onderaannemers zonder toezicht.',
  },
  {
    nr: '02',
    title: '10+ jaar ervaring',
    text: 'Ruime ervaring in gevelrenovatie en voegwerk, van klein herstel tot complete, meerjarige projecten.',
  },
  {
    nr: '03',
    title: 'Vaste kwaliteitsstandaard',
    text: 'Iedere klus volgens dezelfde, hoge afwerkingsnorm — elke keer weer, bij elk project.',
  },
];
---

<Layout
  title="Over ons"
  description="Over Het Gevel Concept — gecertificeerd vakmanschap met meer dan 10 jaar ervaring in gevelrenovatie, actief door heel Nederland."
>
  <!-- Hero -->
  <section class="border-b border-sand-2">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
      <p class="font-display text-sm font-semibold uppercase tracking-wide text-accent">Over ons</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold leading-tight text-primary sm:text-5xl">
        Het professionele gevelrenovatiebedrijf van Nederland.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-primary/75">
        Kwaliteit, betrouwbaarheid en complete ontzorging in gevelrenovatie — van eerste offerte tot laatste voeg.
      </p>
    </div>
  </section>

  <!-- Missie -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-stretch lg:gap-14">
      <Image
        src={gevelImage}
        alt="Bakstenen gevel met deels vernieuwd voegwerk"
        class="aspect-[4/3] w-full rounded-brand object-cover lg:aspect-auto lg:h-full"
        widths={[500, 900, 1300]}
        sizes="(min-width: 1024px) 50vw, 100vw"
      />
      <div class="flex flex-col justify-center">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-accent">Onze missie</h2>
        <p class="mt-4 font-display text-2xl font-semibold leading-snug text-primary sm:text-3xl">
          Wij bouwen aan hét professionele gevelrenovatiebedrijf van Nederland.
        </p>
        <p class="mt-6 text-base leading-relaxed text-primary/75">
          Wij onderscheiden ons door kwaliteit, betrouwbaarheid, duidelijke communicatie en complete ontzorging.
          Geen losse toezeggingen, maar een vast tarief, een heldere planning en een strakke oplevering — bij elk
          project, groot of klein.
        </p>
      </div>
    </div>
  </section>

  <!-- Vakmanschap -->
  <section class="bg-primary py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-accent">Vakmanschap</h2>
      <p class="mt-4 max-w-2xl font-display text-2xl font-semibold leading-snug text-sand sm:text-3xl">
        Al het werk wordt uitgevoerd door gecertificeerde vakspecialisten met meer dan 10 jaar ervaring.
      </p>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {kenmerken.map((k) => (
          <div class="border-t-2 border-accent pt-5">
            <div class="font-display text-3xl font-bold text-accent">{k.nr}</div>
            <h3 class="mt-3 font-display text-lg font-semibold uppercase tracking-wide text-sand">{k.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sand-2/85">{k.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Werkgebied -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">Werkgebied</h2>
    <p class="mt-3 max-w-2xl text-primary/75">Vanuit Harderwijk werken wij door heel Nederland.</p>
    <div class="mt-8">
      <GoogleMap />
    </div>
  </section>

  <CtaBand />
</Layout>
