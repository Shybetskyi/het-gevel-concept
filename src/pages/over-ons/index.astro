---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { SITE } from '../../consts';

const kenmerken = [
  { title: 'Gecertificeerd vakmanschap', text: 'Al ons werk wordt uitgevoerd door gecertificeerde vakspecialisten.' },
  { title: '10+ jaar ervaring', text: 'Ruime ervaring in gevelrenovatie en voegwerk, van klein herstel tot complete projecten.' },
  { title: 'Vaste kwaliteitsstandaard', text: 'Iedere klus volgens dezelfde, hoge afwerkingsnorm — elke keer weer.' },
];
---

<Layout
  title="Over ons"
  description="Over Het Gevel Concept — gecertificeerd vakmanschap met meer dan 10 jaar ervaring in gevelrenovatie, actief in Harderwijk en omstreken."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h1 class="font-display text-4xl font-bold text-primary">Over Het Gevel Concept</h1>
    <p class="mt-4 max-w-2xl text-primary/75">
      Kwaliteit, betrouwbaarheid en complete ontzorging in gevelrenovatie.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-center">
      <ImagePlaceholder label="Gevel in renovatie" class="aspect-[4/3] rounded-brand md:order-2" />
      <div>
        <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-primary">Onze missie</h2>
        <p class="mt-3 text-sm leading-relaxed text-primary/75">
          Het Gevel Concept bouwt aan hét professionele gevelrenovatiebedrijf van Midden-Nederland. Wij
          onderscheiden ons door kwaliteit, betrouwbaarheid, duidelijke communicatie en complete ontzorging — van
          eerste offerte tot laatste voeg.
        </p>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-primary">Vakmanschap</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-primary/75">
        Al het werk wordt uitgevoerd door gecertificeerde vakspecialisten met meer dan 10 jaar ervaring in
        gevelrenovatie en voegwerk.
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {kenmerken.map((k) => (
          <div class="rounded-brand border border-sand-2 bg-paper p-6">
            <h3 class="font-display text-base font-semibold uppercase tracking-wide text-primary">{k.title}</h3>
            <p class="mt-2 text-sm text-primary/75">{k.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-primary">Werkgebied</h2>
        <p class="mt-3 text-sm text-primary/75">
          Wij werken binnen een straal van circa 50 km rondom Harderwijk.
        </p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-primary/80 sm:grid-cols-3">
          {SITE.serviceArea.map((place) => <li>{place}</li>)}
        </ul>
      </div>
      <ImagePlaceholder label="Kaart werkgebied" class="aspect-video rounded-brand" />
    </div>
  </section>

  <CtaBand />
</Layout>
