---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import TrustSqueeze from '../components/TrustSqueeze.astro';
import ServicesBento from '../components/ServicesBento.astro';
import { SERVICES } from '../consts';
import heroImage from '../assets/generated/home-hero.jpg';
import trustWerkwijze from '../assets/generated/trust-werkwijze.jpg';
import trustMaterialen from '../assets/generated/trust-materialen.jpg';
import trustVakmanschap from '../assets/generated/trust-vakmanschap.jpg';
import trustResultaat from '../assets/generated/offerte-voltooid.jpg';
import voegwerkTile from '../assets/generated/voegwerk-closeup.jpg';
import gevelreinigingTile from '../assets/generated/gevelreiniging-na.jpg';
import impregnerenTile from '../assets/generated/impregneren.jpg';
import metselwerkTile from '../assets/generated/metselwerk-herstel.jpg';
import scheurherstelTile from '../assets/generated/scheurherstel.jpg';
import completeTile from '../assets/generated/offerte-voltooid.jpg';

const serviceTiles = [
  { ...SERVICES[0], image: voegwerkTile, imageAlt: 'Close-up van vers aangebracht voegwerk', span: 'lg' as const },
  { ...SERVICES[1], image: gevelreinigingTile, imageAlt: 'Schone bakstenen gevel na reiniging', span: 'md' as const },
  { ...SERVICES[2], image: impregnerenTile, imageAlt: 'Vakman brengt impregneermiddel aan op een gevel', span: 'md' as const },
  { ...SERVICES[3], image: metselwerkTile, imageAlt: 'Vakman vervangt een beschadigde baksteen', span: 'md' as const },
  { ...SERVICES[4], image: scheurherstelTile, imageAlt: 'Herstel van een scheur in het metselwerk', span: 'md' as const },
  { ...SERVICES[5], image: completeTile, imageAlt: 'Volledig gerenoveerde bakstenen gevel', span: 'full' as const },
];

const trustPanels = [
  {
    number: '01',
    label: 'Werkwijze',
    title: 'Heldere afspraken, van A tot Z',
    description:
      'Voor we beginnen leggen we alles vast: de werkzaamheden, de planning en een vaste prijs — geen verrassingen achteraf. U weet vooraf precies waar u aan toe bent.',
    actionLabel: 'Zo werken wij',
    image: trustWerkwijze,
    imageAlt: 'Vakman bespreekt de werkzaamheden met een klant aan de hand van een schets',
  },
  {
    number: '02',
    label: 'Kwaliteit',
    title: 'Materialen die decennia meegaan',
    description:
      'Wij voegen met vorstbestendige, kalkgebonden voegmortel: ademend en flexibel, en aanzienlijk beter bestand tegen vocht dan gewone cementmortel. Op verzoek hydrofoberen we de gevel na — dat houdt slagregen buiten terwijl de muur kan blijven ademen, voor een droger en energiezuiniger huis.',
    actionLabel: 'Onze materialen',
    image: trustMaterialen,
    imageAlt: 'Close-up van voegmortel, baksteen en gereedschap',
  },
  {
    number: '03',
    label: 'Vakmanschap',
    title: 'Vakmensen met oog voor detail',
    description:
      'Al onze voegwerkspecialisten hebben meer dan 10 jaar ervaring en werken volgens de laatste vaktechnieken — netjes, punctueel en met respect voor uw woning. Meerdere van onze vakmensen zijn persoonlijk VCA-gecertificeerd.',
    actionLabel: 'Ons team',
    image: trustVakmanschap,
    imageAlt: 'Ervaren vakman in bedrijfskleding voor een bakstenen gevel',
  },
  {
    number: '04',
    label: 'Resultaat',
    title: 'Een gevel om trots op te zijn',
    description:
      'Een strak gevoegde, beschermde gevel gaat tientallen jaren mee en verhoogt direct de waarde en uitstraling van uw pand.',
    actionLabel: 'Bekijk het resultaat',
    image: trustResultaat,
    imageAlt: 'Volledig gerenoveerde bakstenen gevel met fris voegwerk',
  },
];

const reviews = [
  {
    quote: 'Vakkundig, netjes en precies op de afgesproken tijd. Het voegwerk ziet er weer als nieuw uit.',
    author: 'Marieke de Groot, Harderwijk',
  },
  {
    quote: 'Duidelijke offerte, geen verrassingen achteraf. De gevel is grondig gereinigd en ziet er stralend uit.',
    author: 'Bas Willemsen, Ermelo',
  },
  {
    quote: 'Eindelijk een bedrijf dat doet wat het belooft. Communicatie top, resultaat nog beter.',
    author: 'Sanne Kok, Putten',
  },
  {
    quote: 'Ons pand had al jaren last van vochtplekken. Na het impregneren is dat helemaal verleden tijd.',
    author: 'Ronald Bakker, Nijkerk',
  },
  {
    quote: 'Prettig contact, keurig opgeleverd en de prijs klopte precies met de offerte.',
    author: 'Anouk Hendriks, Zeewolde',
  },
  {
    quote: 'Het uithakken en opnieuw voegen van onze oude gevel is heel secuur gedaan. Aanrader.',
    author: 'Peter van Dijk, Barneveld',
  },
  {
    quote: 'Snel gereageerd op onze aanvraag en binnen twee weken stond de planning vast. Prima werk geleverd.',
    author: 'Ingrid Mulder, Apeldoorn',
  },
  {
    quote: 'Als VvE-bestuur waren we op zoek naar een betrouwbare partij voor groot onderhoud. Die hebben we gevonden.',
    author: 'Henk Postma, Zwolle',
  },
  {
    quote: 'Rustig, professioneel team dat meedenkt. Onze gevel is weer voor jaren beschermd.',
    author: 'Els Visser, Lelystad',
  },
  {
    quote: 'Van eerste gesprek tot oplevering verliep alles soepel. Zeker een aanrader voor gevelrenovatie.',
    author: 'Tom Jansen, Almere',
  },
];
---

<Layout
  title="Home"
  description="Het Gevel Concept — vakkundige gevelrenovatie in Ermelo en omstreken. Voegwerk, gevelreiniging en impregneren. Vast tarief, heldere planning."
>
  <!-- Hero -->
  <section class="border-b border-sand-2">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:py-20 md:grid-cols-2 md:items-center">
      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-accent">
          Voegwerk &amp; gevelrenovatie in Ermelo en heel Nederland
        </p>
        <h1 class="mt-2 font-display text-4xl font-bold leading-tight text-primary sm:text-5xl">
          Vakmanschap zonder <span class="text-accent">compromissen.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-primary/80">
          Wij verzorgen voegwerk, gevelreiniging, impregneren, metselwerk- en scheurherstel — of een complete
          gevelrenovatie in één traject. Vast tarief, heldere planning, strakke oplevering.
        </p>
        <p class="mt-3 max-w-xl text-sm text-primary/70">
          U hoeft zelf niet te bedenken welke aanpak of materialen nodig zijn — wij inspecteren, adviseren en nemen
          het volledige traject uit handen.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact/offerte-aanvragen/"
            class="rounded-brand bg-accent px-7 py-3.5 font-display text-sm font-semibold uppercase tracking-wide text-paper hover:opacity-90"
          >
            Offerte aanvragen
          </a>
          <a
            href="/diensten/"
            class="rounded-brand border border-primary px-7 py-3.5 font-display text-sm font-semibold uppercase tracking-wide text-primary hover:bg-primary hover:text-paper"
          >
            Bekijk diensten
          </a>
        </div>
      </div>
      <Image
        src={heroImage}
        alt="Vakman brengt nieuw voegwerk aan op een bakstenen gevel"
        class="aspect-[4/3] w-full rounded-brand object-cover"
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  </section>

  <!-- Services -->
  <section id="diensten" class="mx-auto max-w-6xl scroll-mt-28 px-5 py-16">
    <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">
      Onze diensten
    </h2>
    <p class="mt-3 max-w-2xl text-primary/75">
      Van een enkele scheur tot een complete gevelrenovatie — wij nemen het volledige traject uit handen.
    </p>
    <div class="mt-8">
      <ServicesBento tiles={serviceTiles} />
    </div>
    <a href="/diensten/" class="mt-6 inline-block text-sm font-semibold text-accent hover:underline">
      Alle diensten bekijken &rarr;
    </a>
  </section>

  <!-- Vertrouwen -->
  <section class="bg-primary py-16">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-sand">
        Waarom Het Gevel Concept
      </h2>
      <p class="mt-3 max-w-2xl text-sand-2/80">
        Vakwerk begint bij vertrouwen. Zo pakken wij het aan, van eerste afspraak tot een gevel die jaren meegaat.
      </p>
      <div class="mt-8">
        <TrustSqueeze panels={trustPanels} />
      </div>
    </div>
  </section>

  <!-- Werkgebied -->
  <section class="border-y border-sand-2 bg-paper py-16">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">
            Ons werkgebied
          </h2>
          <p class="mt-3 max-w-md text-primary/75">
            Het Gevel Concept is gevestigd in Ermelo, maar wij voeren gevelrenovatie- en voegwerkprojecten uit
            door heel Nederland.
          </p>
        </div>
        <div class="mx-auto w-full max-w-sm md:max-w-md">
          <ServiceAreaMap />
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">
      Wat onze klanten zeggen
    </h2>
    <div class="mt-8">
      <ReviewsCarousel reviews={reviews} />
    </div>
  </section>

  <CtaBand />
</Layout>
