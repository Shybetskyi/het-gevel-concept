---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import heroImage from '../assets/generated/home-hero.jpg';
import mapImage from '../assets/generated/werkgebied-kaart.png';
import { SITE } from '../consts';

const services = [
  {
    title: 'Voegwerk uithakken',
    text: 'Oud, verweerd voegwerk vakkundig verwijderd, zodat de nieuwe voeg op een schone, stevige ondergrond wordt aangebracht.',
  },
  {
    title: 'Nieuw voegwerk',
    text: 'Snijvoeg, platvolle voeg of schaduwvoeg — aangebracht met oog voor het originele metselverband.',
  },
  {
    title: 'Gevelreiniging',
    text: 'Professionele reiniging van baksteen: aanslag, mos en vervuiling verwijderd zonder de steen te beschadigen.',
  },
  {
    title: 'Impregneren',
    text: 'Waterafstotende, ademende bescherming tegen vocht en vorstschade — voor jaren extra levensduur.',
  },
];

const reviews = [
  {
    quote: 'Vakkundig, netjes en precies op de afgesproken tijd. Het voegwerk ziet er weer als nieuw uit.',
    author: 'Marieke de Groot, Harderwijk',
  },
  {
    quote: 'Duidelijke offerte, geen verrassingen achteraf. De gevel is grondig gereinigd en ziet er stralend uit.',
    author: 'Bas Willemsen, Ermelo',
  },
  {
    quote: 'Eindelijk een bedrijf dat doet wat het belooft. Communicatie top, resultaat nog beter.',
    author: 'Sanne Kok, Putten',
  },
  {
    quote: 'Ons pand had al jaren last van vochtplekken. Na het impregneren is dat helemaal verleden tijd.',
    author: 'Ronald Bakker, Nijkerk',
  },
  {
    quote: 'Prettig contact, keurig opgeleverd en de prijs klopte precies met de offerte.',
    author: 'Anouk Hendriks, Zeewolde',
  },
  {
    quote: 'Het uithakken en opnieuw voegen van onze oude gevel is heel secuur gedaan. Aanrader.',
    author: 'Peter van Dijk, Barneveld',
  },
  {
    quote: 'Snel gereageerd op onze aanvraag en binnen twee weken stond de planning vast. Prima werk geleverd.',
    author: 'Ingrid Mulder, Apeldoorn',
  },
  {
    quote: 'Als VvE-bestuur waren we op zoek naar een betrouwbare partij voor groot onderhoud. Die hebben we gevonden.',
    author: 'Henk Postma, Zwolle',
  },
  {
    quote: 'Rustig, professioneel team dat meedenkt. Onze gevel is weer voor jaren beschermd.',
    author: 'Els Visser, Lelystad',
  },
  {
    quote: 'Van eerste gesprek tot oplevering verliep alles soepel. Zeker een aanrader voor gevelrenovatie.',
    author: 'Tom Jansen, Almere',
  },
];
---

<Layout
  title="Home"
  description="Het Gevel Concept — vakkundige gevelrenovatie in Harderwijk en omstreken. Voegwerk, gevelreiniging en impregneren. Vast tarief, heldere planning."
>
  <!-- Hero -->
  <section class="border-b border-sand-2">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:py-20 md:grid-cols-2 md:items-center">
      <div>
        <h1 class="font-display text-4xl font-bold leading-tight text-primary sm:text-5xl">
          Vakmanschap zonder <span class="text-accent">compromissen.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-primary/80">
          Complete gevelrenovatie. Vast tarief, heldere planning, strakke oplevering — elke keer weer.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact/offerte-aanvragen/"
            class="rounded-brand bg-accent px-7 py-3.5 font-display text-sm font-semibold uppercase tracking-wide text-paper hover:opacity-90"
          >
            Offerte aanvragen
          </a>
          <a
            href="/diensten/"
            class="rounded-brand border border-primary px-7 py-3.5 font-display text-sm font-semibold uppercase tracking-wide text-primary hover:bg-primary hover:text-paper"
          >
            Bekijk diensten
          </a>
        </div>
      </div>
      <Image
        src={heroImage}
        alt="Vakman brengt nieuw voegwerk aan op een bakstenen gevel"
        class="aspect-[4/3] w-full rounded-brand object-cover"
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">
      Onze diensten
    </h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => (
        <div class="rounded-brand border border-sand-2 bg-paper p-6">
          <h3 class="font-display text-base font-semibold uppercase tracking-wide text-primary">
            {s.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-primary/75">{s.text}</p>
        </div>
      ))}
    </div>
    <a href="/diensten/" class="mt-6 inline-block text-sm font-semibold text-accent hover:underline">
      Alle diensten bekijken &rarr;
    </a>
  </section>

  <!-- Werkgebied -->
  <section class="border-y border-sand-2 bg-paper py-16">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">
        Ons werkgebied
      </h2>
      <p class="mt-3 max-w-2xl text-primary/75">
        Wij werken binnen een straal van circa 50 km rondom Harderwijk.
      </p>
      <div class="mt-8 grid gap-8 md:grid-cols-2 md:items-center">
        <Image
          src={mapImage}
          alt="Kaart met werkgebied rondom Harderwijk: Ermelo, Putten, Nijkerk, Zeewolde, Barneveld, Apeldoorn, Zwolle, Lelystad en Almere"
          class="w-full rounded-brand object-cover"
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-primary/80 sm:grid-cols-3">
          {SITE.serviceArea.map((place) => <li>{place}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-primary">
      Wat onze klanten zeggen
    </h2>
    <div class="mt-8">
      <ReviewsCarousel reviews={reviews} />
    </div>
  </section>

  <CtaBand />
</Layout>
