---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden" description="Deze pagina bestaat niet.">
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <p class="font-display text-sm font-semibold uppercase tracking-wide text-accent">404</p>
    <h1 class="mt-3 font-display text-3xl font-bold text-primary">Pagina niet gevonden</h1>
    <p class="mt-4 text-primary/75">
      De pagina die u zoekt bestaat niet (meer). Ga terug naar de homepage of vraag direct een offerte aan.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="rounded-brand border border-primary px-6 py-3 font-display text-sm font-semibold uppercase text-primary hover:bg-primary hover:text-paper">
        Naar de homepage
      </a>
      <a href="/contact/offerte-aanvragen/" class="rounded-brand bg-accent px-6 py-3 font-display text-sm font-semibold uppercase text-paper hover:opacity-90">
        Offerte aanvragen
      </a>
    </div>
  </section>
</Layout>
