---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import voltooidImage from '../../assets/generated/offerte-voltooid.jpg';
import { SITE } from '../../consts';

const diensten = ['Voegwerk uithakken', 'Nieuw voegwerk', 'Gevelreiniging', 'Impregneren', 'Anders'];
---

<Layout
  title="Offerte aanvragen"
  description="Vraag vrijblijvend een offerte aan bij Het Gevel Concept. Wij nemen binnen twee werkdagen contact met u op."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h1 class="font-display text-4xl font-bold text-primary">Offerte aanvragen</h1>
    <p class="mt-4 max-w-xl text-primary/75">
      Vul het formulier in en wij nemen binnen twee werkdagen contact met u op.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_320px]">
      <form
        id="offerte-form"
        class="space-y-6 rounded-brand border border-sand-2 bg-paper p-7"
        method="post"
        action="/api/offerte"
        enctype="multipart/form-data"
      >
        <fieldset class="grid gap-5 sm:grid-cols-2">
          <legend class="mb-1 font-display text-sm font-semibold uppercase tracking-wide text-primary sm:col-span-2">
            Uw gegevens
          </legend>

          <div class="sm:col-span-2 sm:max-w-xs">
            <label for="aanhef" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Aanhef
            </label>
            <select id="aanhef" name="aanhef" class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary">
              <option value="Dhr.">Dhr.</option>
              <option value="Mevr.">Mevr.</option>
            </select>
          </div>

          <div>
            <label for="voornaam" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Voornaam
            </label>
            <input id="voornaam" name="voornaam" type="text" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>
          <div>
            <label for="achternaam" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Achternaam
            </label>
            <input id="achternaam" name="achternaam" type="text" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>

          <div class="sm:col-span-2">
            <label for="straat" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Straat en huisnummer
            </label>
            <input id="straat" name="straat" type="text" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>
          <div>
            <label for="postcode" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Postcode
            </label>
            <input id="postcode" name="postcode" type="text" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>
          <div>
            <label for="plaats" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Plaats
            </label>
            <input id="plaats" name="plaats" type="text" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>

          <div>
            <label for="telefoon" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              Telefoonnummer
            </label>
            <input id="telefoon" name="telefoon" type="tel" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
              E-mailadres
            </label>
            <input id="email" name="email" type="email" required class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary" />
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-primary">
            Gewenste diensten
          </legend>
          <div class="grid gap-2.5 sm:grid-cols-2">
            {diensten.map((d) => (
              <label class="flex items-center gap-2.5 text-sm text-primary/85">
                <input type="checkbox" name="diensten" value={d} class="h-4 w-4 accent-accent" />
                {d}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="fotos" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
            Foto's van de gevel (optioneel)
          </label>
          <div
            id="fotos-dropzone"
            class="flex w-full cursor-pointer flex-col items-center gap-2 rounded-brand border border-dashed border-sand-2 bg-sand/40 px-3.5 py-6 text-center"
          >
            <button
              type="button"
              id="fotos-button"
              class="rounded-brand bg-primary px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-sand"
            >
              Bestand kiezen
            </button>
            <p id="fotos-filename" class="text-sm text-primary/70">Geen bestand gekozen</p>
          </div>
          <input id="fotos" name="fotos" type="file" accept=".jpg,.jpeg,.png,.pdf" multiple class="hidden" />
          <p class="mt-1.5 text-xs text-mortar">jpg, png of pdf, max 5MB per bestand</p>
        </div>

        <div>
          <label for="opmerkingen" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-mortar">
            Opmerkingen
          </label>
          <textarea
            id="opmerkingen"
            name="opmerkingen"
            rows="4"
            class="w-full rounded-brand border border-sand-2 bg-paper px-3.5 py-2.5 text-sm text-primary"
          ></textarea>
        </div>

        <!-- Honeypot anti-spam field, hidden from real visitors -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <button
          type="submit"
          class="w-full rounded-brand bg-accent px-6 py-3.5 font-display text-sm font-semibold uppercase tracking-wide text-paper hover:opacity-90 sm:w-auto"
        >
          Offerte aanvragen
        </button>

        <p id="offerte-form-status" class="text-sm" role="status"></p>
      </form>

      <aside class="space-y-6">
        <div class="rounded-brand bg-primary p-6 text-sand">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-sand-2">Contactgegevens</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href={SITE.phoneHref} class="hover:text-accent">{SITE.phone}</a></li>
            <li>{SITE.address.street}</li>
            <li>{SITE.address.postalCode} {SITE.address.city}</li>
            <li class="text-sand-2/70">KvK {SITE.kvk}</li>
          </ul>
        </div>
        <div class="rounded-brand border border-sand-2 bg-paper p-6">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-primary">Reactietijd</h2>
          <p class="mt-2 text-sm text-primary/75">
            Wij streven ernaar binnen twee werkdagen te reageren op elke aanvraag, met een vrijblijvende offerte
            op maat.
          </p>
        </div>
        <Image
          src={voltooidImage}
          alt="Voltooide gevelrenovatie van een bakstenen woning"
          class="aspect-[3/4] w-full rounded-brand object-cover"
          widths={[300, 500]}
          sizes="320px"
        />
      </aside>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('offerte-form') as HTMLFormElement | null;
  const status = document.getElementById('offerte-form-status');

  const fotosInput = document.getElementById('fotos') as HTMLInputElement | null;
  const fotosButton = document.getElementById('fotos-button');
  const fotosDropzone = document.getElementById('fotos-dropzone');
  const fotosFilename = document.getElementById('fotos-filename');

  function openFotosPicker() {
    fotosInput?.click();
  }

  fotosButton?.addEventListener('click', openFotosPicker);
  fotosDropzone?.addEventListener('click', (event) => {
    if (event.target !== fotosButton) openFotosPicker();
  });

  fotosInput?.addEventListener('change', () => {
    if (!fotosFilename) return;
    const files = fotosInput.files;
    if (!files || files.length === 0) {
      fotosFilename.textContent = 'Geen bestand gekozen';
    } else if (files.length === 1) {
      fotosFilename.textContent = files[0].name;
    } else {
      fotosFilename.textContent = `${files.length} bestanden gekozen`;
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    status.textContent = 'Bezig met verzenden...';
    status.className = 'text-sm text-mortar';

    try {
      const response = await fetch('/api/offerte', {
        method: 'POST',
        body: new FormData(form),
      });

      if (!response.ok) throw new Error('request_failed');

      status.textContent = 'Bedankt! Wij nemen binnen twee werkdagen contact met u op.';
      status.className = 'text-sm text-accent';
      form.reset();
    } catch {
      status.textContent =
        'Er ging iets mis bij het verzenden. Bel ons gerust direct, of probeer het later opnieuw.';
      status.className = 'text-sm text-red-700';
    }
  });
</script>
