---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import closeupImage from '../../assets/generated/voegwerk-closeup.jpg';
import VoegDiagram from '../../components/VoegDiagram.astro';

const voegtypes = [
  {
    title: 'Snijvoeg',
    type: 'snijvoeg' as const,
    text: 'Vlak met de steen, met messcherp gesneden randen aan boven- en onderzijde — een strakke, zeer precieze voeglijn.',
  },
  {
    title: 'Platvolle voeg',
    type: 'platvol' as const,
    text: 'De traditionele voeg, gelijk met het steenvlak afgewerkt, zonder uitstekende rand — tijdloos en robuust.',
  },
  {
    title: 'Schaduwvoeg',
    type: 'schaduwvoeg' as const,
    text: 'De voeg ligt verdiept ten opzichte van de steen, waardoor een duidelijke schaduwlijn en meer reliëf ontstaat.',
  },
];
---

<Layout
  title="Voegwerk"
  description="Voegwerk uithakken en nieuw voegwerk aanbrengen — snijvoeg, platvolle voeg of schaduwvoeg. Vakkundig gevelherstel door Het Gevel Concept."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">
      <a href="/diensten/" class="hover:underline">Diensten</a> / Voegwerk
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold text-primary">Voegwerk</h1>
    <p class="mt-4 max-w-2xl text-primary/75">
      De voeg is het meest kwetsbare onderdeel van een gevel — en het onderdeel dat het meeste vakmanschap vraagt.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-primary">
          Uithakken van oud voegwerk
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-primary/75">
          Verweerd of loszittend voegwerk wordt zorgvuldig uitgehakt tot op de juiste diepte, zonder schade aan de
          bakstenen. Zo ontstaat een schone, stevige ondergrond voor het nieuwe voegwerk.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-primary">
          Nieuw voegwerk aanbrengen
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-primary/75">
          Met de juiste mortelsamenstelling en kleur brengen wij nieuw voegwerk aan dat aansluit op het bestaande
          metselverband — strak, gelijkmatig en duurzaam.
        </p>
      </div>
    </div>

    <Image
      src={closeupImage}
      alt="Close-up van handen die vers voegwerk aanbrengen met een voegspijker"
      class="mt-12 aspect-[21/9] w-full rounded-brand object-cover"
      widths={[600, 1000, 1600]}
      sizes="100vw"
    />

    <h2 class="mt-16 font-display text-lg font-semibold uppercase tracking-wide text-primary">Voegtypes</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-3">
      {voegtypes.map((v) => (
        <div class="rounded-brand border border-sand-2 bg-paper p-6">
          <div class="aspect-square w-full rounded-brand bg-sand p-4">
            <VoegDiagram type={v.type} />
          </div>
          <h3 class="mt-4 font-display text-base font-semibold uppercase tracking-wide text-primary">{v.title}</h3>
          <p class="mt-2 text-sm text-primary/75">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <CtaBand />
</Layout>
