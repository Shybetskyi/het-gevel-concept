---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceAccordion from '../../components/ServiceAccordion.astro';
import resultaatImage from '../../assets/generated/offerte-voltooid.jpg';

const accordion = [
  {
    question: 'Hoe het werkt',
    answer:
      'We beginnen met een gratis inspectie van de hele gevel en stellen vast wat er nodig is: voegwerk, metselwerk- of scheurherstel, reiniging en/of impregneren. U krijgt één heldere offerte met vaste prijs voor het complete traject — geen losse deelfacturen, geen verrassingen tijdens het werk.',
  },
  {
    question: 'Waarom dit belangrijk is',
    answer:
      'Een gevel is één samenhangend geheel: verweerd voegwerk leidt tot vochtschade, vochtschade leidt tot scheuren en beschadigde stenen. Wie dit los van elkaar laat repareren, betaalt vaak dubbel. Bij een complete renovatie pakken we de oorzaak en het gevolg in één keer aan.',
  },
  {
    question: 'Wat het oplevert',
    answer:
      'U hoeft zelf niet te bedenken welke aanpak, materialen of extra werkzaamheden nodig zijn — wij inspecteren, adviseren en voeren het volledige traject uit, van eerste opname tot een opgeleverde gevel die er weer jaren tegen kan.',
  },
  {
    question: 'Materialen die we gebruiken',
    answer:
      'Per onderdeel de juiste materialen: vorstbestendige kalkgebonden voegmortel, passende baksteen bij metselwerkherstel, spiraalankers of injectiehars bij scheurherstel, en een dampopen hydrofoberingslaag als afsluiting — altijd afgestemd op de bestaande gevel.',
  },
];
---

<Layout
  title="Complete gevelrenovatie"
  description="Complete gevelrenovatie door Het Gevel Concept — voegwerk, metselwerk- en scheurherstel, reiniging en impregneren in één traject, met vaste prijs."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">
      <a href="/diensten/" class="hover:underline">Diensten</a> / Complete gevelrenovatie
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold text-primary">Complete gevelrenovatie</h1>
    <p class="mt-4 max-w-2xl text-primary/75">
      Alle diensten gecombineerd in één traject, van eerste inspectie tot opgeleverde, beschermde gevel — u regelt
      niets zelf, wij nemen het volledig uit handen.
    </p>

    <Image
      src={resultaatImage}
      alt="Volledig gerenoveerde bakstenen gevel met fris voegwerk"
      class="mt-12 aspect-[21/9] w-full rounded-brand object-cover"
      widths={[600, 1000, 1600]}
      sizes="100vw"
    />

    <h2 class="mt-16 font-display text-lg font-semibold uppercase tracking-wide text-primary">In detail</h2>
    <div class="mt-6">
      <ServiceAccordion items={accordion} />
    </div>
  </section>

  <CtaBand />
</Layout>
