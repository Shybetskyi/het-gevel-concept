---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../consts';

const upcoming = ['Steenvervanging', 'Gevelcoating'];
---

<Layout
  title="Diensten"
  description="Voegwerk, gevelreiniging, impregneren, metselwerk- en scheurherstel, en complete gevelrenovatie door Het Gevel Concept — vakkundig, met vaste prijzen en heldere planning."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h1 class="font-display text-4xl font-bold text-primary">Onze diensten</h1>
    <p class="mt-4 max-w-2xl text-primary/75">
      Vakmanschap zonder compromissen, van gevel tot voeg. U hoeft niet te bedenken welke aanpak of materialen nodig
      zijn — wij inspecteren, adviseren en voeren het volledige traject uit.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {SERVICES.map((s) => (
        <a
          href={`/diensten/${s.slug}/`}
          class="group rounded-brand border border-sand-2 bg-paper p-8 transition hover:border-accent"
        >
          <h2 class="font-display text-xl font-semibold uppercase tracking-wide text-primary group-hover:text-accent">
            {s.title}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-primary/75">{s.short}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-accent">Meer info &rarr;</span>
        </a>
      ))}
    </div>

    <div class="mt-16 border-t border-sand-2 pt-10">
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-mortar">
        Binnenkort beschikbaar
      </h2>
      <ul class="mt-4 flex flex-wrap gap-3 text-sm text-primary/70">
        {upcoming.map((item) => (
          <li class="rounded-brand border border-sand-2 px-4 py-2">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>
