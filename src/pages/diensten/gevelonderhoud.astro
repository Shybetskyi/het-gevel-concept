---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';

const benefits = [
  'Langere levensduur van de gevel',
  'Behoud van de waarde van uw woning',
  'Voorkomen van vochtschade',
];
---

<Layout
  title="Gevelonderhoud"
  description="Gevelreiniging en impregneren door Het Gevel Concept — bescherming en verzorging van uw gevel in Harderwijk en omstreken."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">
      <a href="/diensten/" class="hover:underline">Diensten</a> / Gevelonderhoud
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold text-primary">Gevelonderhoud</h1>
    <p class="mt-4 max-w-2xl text-primary/75">
      Een schone, beschermde gevel gaat jaren langer mee. Onderhoud is de goedkoopste renovatie die er is.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div>
        <ImagePlaceholder label="Gevelreiniging — voor/na" class="aspect-[4/3] rounded-brand" />
        <h2 class="mt-5 font-display text-lg font-semibold uppercase tracking-wide text-primary">
          Gevelreiniging
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-primary/75">
          Wij verwijderen aanslag, mos en vervuiling van baksteen met professionele reinigingsmethoden, zonder de
          steen of het voegwerk te beschadigen.
        </p>
      </div>
      <div>
        <ImagePlaceholder label="Impregneren aanbrengen" class="aspect-[4/3] rounded-brand" />
        <h2 class="mt-5 font-display text-lg font-semibold uppercase tracking-wide text-primary">
          Impregneren
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-primary/75">
          Een waterafstotende, ademende impregneerlaag beschermt de gevel tegen vocht en vorstschade, zonder de
          steen af te sluiten.
        </p>
      </div>
    </div>

    <div class="mt-16 rounded-brand border border-sand-2 bg-paper p-8">
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-primary">Waarom onderhoud</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {benefits.map((b) => (
          <li class="text-sm text-primary/80">{b}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>
